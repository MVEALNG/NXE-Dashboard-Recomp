<?xml version="1.0" encoding="UTF-8"?>
<homepage>
<defaultchannelid>XBOX360</defaultchannelid>
<channel>
<id>Games</id>
<channeldef>
<condition>EcoInLiveLocale()</condition>
<description>%EvResStr(IDS_GAMES)%</description>
<slot>
<epixid>GAMES</epixid>
<onclick>
<action>EpixCmd</action>
<cmd>EcNavToLiveUpsell</cmd>
<button>A</button>
<helptext>%EvResStr(IDS_TELLMEMORE)%</helptext>
</onclick>
</slot>
<slot>
<name>Games Library</name>
<description>%EvResStr(IDS_GAMESLIBRARY)</description>
<epixid>GAMES_LIBRARY</epixid>
<onclick>
<button>A</button>
<helptext>%EvResStr(IDS_SELECTSLOT)%</helptext>
<action>EpixCmd</action>
<cmd>EcNavToGamesLibrary</cmd>
</onclick>
<tracking>none</tracking>
</slot>
<epix>
<id>GAMES</id>
<format>EpixScene</format>
<path>EsOfflineGames</path>
</epix>
<epix>
<id>GAMES_LIBRARY</id>
